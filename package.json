{
  "name": "constellation-mcp",
  "version": "0.1.0",
  "description": "Constellation MCP — orchestration-aware browser isolation and engagement tooling for agent teams (DST-Comet)",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DotJumpDot/Constellation-MCP.git"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "constellation-mcp": "cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx/esm --test tests/*.spec.ts",
    "smoke": "node --import tsx/esm scripts/smoke.ts",
    "verify": "npm run build && npm run test && npm run mcp-smoke",
    "mcp-smoke": "node --import tsx/esm scripts/mcp-smoke.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.2",
    "imapflow": "^1.0.218",
    "mailparser": "^3.7.4",
    "playwright-core": "^1.56.1",
    "tough-cookie": "^5.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
